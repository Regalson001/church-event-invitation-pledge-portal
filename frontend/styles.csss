:root {
    --ink: #18271f;
    --green: #315c45;
    --green-dark: #203e30;
    --muted: #778177;
    --cream: #f5f4ec;
    --paper: #fffef9;
    --line: #e5e7dc;
    --lime: #d9e7a5;
    --gold: #c6a46a;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--cream);
    color: var(--ink);
    font-family: "DM Sans", sans-serif;
    line-height: 1.6;
}

button,
input,
select,
textarea {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

a {
    color: inherit;
}

.site-header {
    min-height: 82px;
    padding: 0 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
}

.brand {
    color: var(--ink);
    text-decoration: none;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -1.8px;
}

.brand span {
    color: #8aa65c;
}

.navigation {
    display: flex;
    align-items: center;
    gap: 28px;
}

.navigation a {
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s ease;
}

.navigation a:hover {
    color: var(--green);
}

.admin-button {
    padding: 11px 17px;
    border: 1px solid #b9c3b6;
    border-radius: 3px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 12px;
}

.hero {
    padding: 85px 9%;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 7%;
}

.eyebrow {
    color: #71875e;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

.hero h1 {
    margin: 22px 0;
    font-size: clamp(48px, 6.5vw, 86px);
    letter-spacing: -5px;
    line-height: 1.04;
}

.hero h1 em,
h2 em {
    color: var(--green);
    font-family: "Playfair Display", serif;
    font-weight: 500;
}

.hero-description {
    max-width: 500px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
}

.hero-actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 30px;
}

.primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 15px 20px;
    border: 0;
    border-radius: 3px;
    background: var(--green);
    color: white;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
}

.primary-button:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
}

.primary-button span {
    font-size: 17px;
}

.secondary-link {
    font-size: 12px;
    text-decoration: none;
}

.hero-stats {
    display: flex;
    gap: 55px;
    margin-top: 55px;
}

.hero-stats div {
    display: grid;
    gap: 4px;
}

.hero-stats strong {
    font-family: "Playfair Display", serif;
    font-size: 26px;
    font-weight: 500;
}

.hero-stats span {
    color: var(--muted);
    font-size: 10px;
}

.hero-art {
    position: relative;
    min-height: 450px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 48% 48% 3px 3px;
    background: linear-gradient(
        145deg,
        #a8b98c,
        #456d53 65%,
        #263f34
    );
    color: white;
}

.art-sun {
    position: absolute;
    top: 65px;
    right: 13%;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: #e9d9a9;
}

.hero-art::before,
.hero-art::after {
    position: absolute;
    bottom: -130px;
    left: -10%;
    width: 120%;
    height: 240px;
    border-radius: 50%;
    background: #294d3b;
    content: "";
    transform: rotate(-12deg);
}

.hero-art::after {
    bottom: -175px;
    left: 0;
    background: #1f3b30;
    transform: rotate(10deg);
}

.art-message {
    z-index: 1;
    margin-top: 90px;
    font-family: "Playfair Display", serif;
    font-size: 27px;
    font-style: italic;
    line-height: 1.5;
    text-align: center;
}

.art-message span {
    color: var(--lime);
}

.art-footer {
    position: absolute;
    z-index: 2;
    bottom: 22px;
    font-size: 8px;
    letter-spacing: 2px;
}

.event-details {
    padding: 28px 9%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    background: #e9eddf;
}

.event-details div {
    display: grid;
    gap: 7px;
}

.event-details span {
    color: #71816e;
    font-size: 9px;
    letter-spacing: 1.5px;
}

.event-details strong {
    font-size: 11px;
}

.section-container {
    padding: 95px 10%;
}

.introduction {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
}

.introduction h2,
.form-card h2,
.closing-section h2 {
    margin-top: 12px;
    font-family: "Playfair Display", serif;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -1px;
}

.introduction > p {
    max-width: 500px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
}

.forms-section {
    padding: 0 9% 95px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
}

.form-card {
    padding: 38px;
    border: 1px solid var(--line);
    background: var(--paper);
    scroll-margin-top: 25px;
}

.form-card h2 {
    font-size: 38px;
}

.form-description {
    margin: 12px 0 25px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.form-card form {
    display: grid;
    gap: 13px;
}

.form-card label,
.modal-panel label {
    color: #465448;
    font-size: 11px;
    font-weight: 700;
}

.form-card input,
.form-card select,
.form-card textarea,
.modal-panel input {
    width: 100%;
    min-height: 43px;
    padding: 12px;
    border: 1px solid #dfe3d9;
    border-radius: 2px;
    outline: none;
    background: #fffefa;
    color: var(--ink);
    font-size: 12px;
}

.form-card textarea {
    resize: vertical;
}

.form-card input:focus,
.form-card select:focus,
.form-card textarea:focus,
.modal-panel input:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 2px #315c4514;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.form-row > div {
    display: grid;
    gap: 8px;
}

.full-button {
    width: 100%;
    margin-top: 8px;
}

.form-feedback {
    min-height: 16px;
    color: var(--green);
    font-size: 11px;
}

.notice {
    margin-top: 15px;
    color: #8b9286;
    font-size: 10px;
}

.closing-section {
    padding: 80px 20px;
    background: #e9eddf;
    text-align: center;
}

.closing-section h2 {
    margin: 15px 0 25px;
    font-size: 52px;
}

.site-footer {
    padding: 28px 9%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--paper);
}

.site-footer p {
    color: var(--muted);
    font-size: 10px;
}

/* Organizer dashboard */

.modal {
    position: fixed;
    z-index: 10;
    inset: 0;
    padding: 20px;
    display: grid;
    place-items: center;
    overflow-y: auto;
    background: #102017bb;
}

.hidden {
    display: none !important;
}

.modal-panel {
    position: relative;
    width: min(850px, 100%);
    max-height: 90vh;
    padding: 35px;
    overflow-y: auto;
    background: var(--paper);
}

.modal-panel h2 {
    margin: 10px 0 20px;
    font-family: "Playfair Display", serif;
    font-size: 35px;
    font-weight: 500;
}

.modal-panel > label {
    display: block;
    margin-bottom: 8px;
}

.modal-panel > input {
    margin-bottom: 15px;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 18px;
    border: 0;
    background: none;
    font-size: 28px;
    cursor: pointer;
}

.dashboard-actions {
    display: flex;
    gap: 10px;
    margin: 25px 0;
}

.modal-panel h3 {
    margin: 20px 0 10px;
    font-size: 14px;
}

.table-container {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
}

th,
td {
    padding: 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
}

th {
    color: var(--muted);
}

@media (max-width: 850px) {
    .hero {
        grid-template-columns: 1fr;
        padding: 60px 7%;
    }

    .hero-art {
        min-height: 350px;
    }

    .event-details {
        grid-template-columns: 1fr 1fr;
    }

    .forms-section {
        padding-right: 5%;
        padding-left: 5%;
    }

    .navigation {
        gap: 12px;
    }

    .navigation a {
        display: none;
    }
}

@media (max-width: 600px) {
    .site-header {
        min-height: 70px;
        padding: 0 5%;
    }

    .hero h1 {
        letter-spacing: -3px;
    }

    .hero-art {
        min-height: 290px;
    }

    .introduction {
        grid-template-columns: 1fr;
    }

    .section-container {
        padding: 65px 7%;
    }

    .forms-section {
        grid-template-columns: 1fr;
        padding-bottom: 60px;
    }

    .form-card {
        padding: 25px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .hero-stats {
        gap: 35px;
        margin-top: 35px;
    }

    .event-details {
        padding: 25px 7%;
    }

    .closing-section h2 {
        font-size: 43px;
    }

    .site-footer {
        padding: 25px 7%;
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .dashboard-actions {
        flex-direction: column;
    }
}
